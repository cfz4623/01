# clang-format 格式化配置（适用于 clangd / VSCode）
# 本配置采用标准的 C 排版格式，适用于 ESP-IDF 项目
# 规则：4 空格缩进、花括号独占一行（Allman）、返回类型与函数名同行
# 注意：不要添加 Language 键限定语言，否则 .c 文件（C 语言）会被跳过

BasedOnStyle: LLVM

# ================= 缩进设置（4 个空格） =================
IndentWidth: 4                  # 代码块缩进宽度
TabWidth: 4                     # Tab 对应的显示宽度
UseTab: Never                   # 禁止使用 Tab，一律用空格缩进
ContinuationIndentWidth: 4      # 续行（参数折行）时的缩进宽度
IndentCaseLabels: true          # switch 中的 case 标签缩进一级
IndentPPDirectives: None        # 预处理指令（#define 等）不缩进
IndentWrappedFunctionNames: false  # 折行的函数名不额外缩进

# ================= 花括号风格（Allman：独占一行） =================
BreakBeforeBraces: Allman       # 左花括号换行，不跟随代码右侧
AllowShortFunctionsOnASingleLine: None  # 函数体不允许单行书写
AllowShortIfStatementsOnASingleLine: Never  # if 语句不允许单行
AllowShortLoopsOnASingleLine: false     # for/while 不允许单行
AllowShortBlocksOnASingleLine: Never    # 代码块不允许单行
AllowShortEnumsOnASingleLine: false     # 枚举不允许单行

# ================= 函数返回类型（与函数名同行） =================
AlwaysBreakAfterReturnType: None          # 返回类型与函数名写在同一行
AlwaysBreakAfterDefinitionReturnType: None  # 函数定义时返回类型不换行

# ================= 换行与折行 =================
ColumnLimit: 100                # 单行最大宽度 100 字符，超出自动折行
MaxEmptyLinesToKeep: 1          # 最多保留 1 个连续空行
BinPackArguments: false         # 函数调用的参数不挤在同一行
BinPackParameters: false        # 函数声明的参数不挤在同一行
AllowAllParametersOfDeclarationOnNextLine: true  # 参数允许整体折行
AllowAllArgumentsOnNextLine: true     # 调用参数允许整体折行
BreakBeforeBinaryOperators: NonAssignment  # 二元运算符换行时放在上一行末尾
AlignOperands: Align            # 折行后操作数对齐

# ================= 空格规则 =================
SpaceBeforeParens: ControlStatements  # 关键字（if/for/while）后加空格，函数名后不加
SpaceAfterCStyleCast: false     # C 风格强转后不加空格
SpacesInParentheses: false      # 括号内侧不加空格
SpacesInSquareBrackets: false   # 方括号内侧不加空格
SpacesInAngles: false           # 尖括号内侧不加空格
SpaceInEmptyParentheses: false  # 空括号内不加空格
SpaceBeforeSquareBrackets: false  # 数组下标前不加空格
SpacesBeforeTrailingComments: 1 # 行尾注释前保留 1 个空格
PointerAlignment: Left          # 指针符号靠左：int *p
ReferenceAlignment: Pointer     # 引用符号靠左

# ================= 其他设置 =================
SortIncludes: true              # 头文件按字典序自动排序
IncludeBlocks: Preserve         # 保留头文件分组，仅组内排序
AlignAfterOpenBracket: Align    # 括号后的参数对齐
AlignTrailingComments: true     # 行尾注释对齐
IndentCaseBlocks: false         # case 代码块花括号不额外缩进
